#include "base/version.h"

1 24 "windows.manifest"

1 VERSIONINFO
FILEVERSION SC2K_VERSION_MAJOR,SC2K_VERSION_MINOR,SC2K_VERSION_PATCH,0
PRODUCTVERSION SC2K_VERSION_MAJOR,SC2K_VERSION_MINOR,SC2K_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
#if SC2K_VERSION_STAGE < 3
FILEFLAGS 0x2L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", SC2K_APP_TITLE "\0"
      VALUE "FileVersion", SC2K_VERSION_DISPLAY "\0"
      VALUE "ProductName", "OpenSC2k\0"
      VALUE "ProductVersion", SC2K_VERSION_DISPLAY "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
